# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Die Vorlage MUSS mit: Sie ist die Liste dessen, was in der Amplify-Konsole
# eingetragen werden muss, und enthält selbst keine Werte.
!.env.example

# ⚠️ KUNDENUNTERLAGEN – NICHT IN EIN ÖFFENTLICHES REPOSITORY.
# `docs/` enthält das Markenhandbuch, die Kickoff-Zusammenfassung und das
# Projekt-Briefing mit Honorar, offenen Rechtsfragen, Telefonnummer und dem
# Hinweis, dass die Bewertungen vorläufig sind. Das gehört dem Kunden und
# nicht auf eine öffentliche URL. Liegt weiter lokal im Projektordner.
/docs/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
