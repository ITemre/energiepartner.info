# Bitrix24 – eingehender Webhook (CRM-Recht) für crm.lead.add
# Echten Wert in .env.local eintragen (nicht committen).
BITRIX24_WEBHOOK_URL=https://<portal>.bitrix24.de/rest/<user_id>/<webhook_code>/
BITRIX24_DOMAIN=<portal>.bitrix24.de

# Ziel des Verweises von energiepartner.info auf die Angebotsprüfung.
# Ohne diesen Wert zeigt der Verweis auf den internen Pfad /av – praktisch
# für Vorführung und lokale Arbeit, aber in Produktion würde die zweite
# Marke damit unter der falschen Domain laufen.
# SOBALD angebote-vergleichen.info live ist, hier setzen:
NEXT_PUBLIC_AV_URL=https://angebote-vergleichen.info

# Google-Rezensionen (Places API New).
# ⚠️ KEIN NEXT_PUBLIC_-Präfix. Der Schlüssel darf den Server nie verlassen –
# mit Präfix landet er in jedem Browser-Bundle, und Places-Aufrufe kosten.
# Im Google-Cloud-Projekt zusätzlich beschränken: API auf „Places API (New)",
# Anwendung auf die Server-IP.
GOOGLE_PLACES_API_KEY=

# Optional. Ohne Eintrag sucht die Anwendung die Place-ID beim ersten Abruf
# selbst und schreibt sie ins Server-Log – von dort abschreiben und hier
# eintragen, dann entfällt der Suchaufruf dauerhaft.
GOOGLE_PLACE_ID=

# Vorlaeufige Stimmen fuer Praesentationen. NUR lokal setzen, niemals live.
# Wert "an" aktiviert sie; jeder andere Wert und jede Produktionsumgebung
# schalten sie ab (siehe src/lib/stimmen-platzhalter.ts).
PLATZHALTER_INHALTE=
