# 
# Umgebungsvariablen · energiepartner.info + angebote-vergleichen.info
# 
#
# Lokal:  Werte in `.env.local` eintragen (steht in .gitignore).
# Vercel: Project Settings → Environment Variables.
#
# ANDERS ALS BEI AMPLIFY braucht es keinen Umweg über eine
# `.env.production`: Vercel reicht die Variablen sowohl dem Build als auch
# der Laufzeit durch. Der entsprechende `grep`-Trick in `amplify.yml` ist auf
# Vercel überflüssig (und schadet dort auch nicht, die Datei wird ignoriert).

# ─── Bitrix24 · eingehender Webhook für crm.lead.add ──────────────────
# Wird zur ANFRAGEZEIT gelesen (`src/app/api/lead/route.ts`).
# Secret. Bei Leak: Webhook in Bitrix löschen und neu erzeugen.
# Nötig auf: Production, Preview.
BITRIX24_WEBHOOK_URL=https://<portal>.bitrix24.de/rest/<user_id>/<webhook_code>/
BITRIX24_DOMAIN=<portal>.bitrix24.de

# ─── Ziel des Verweises von energiepartner.info auf die Prüfstrecke ───
# Ohne Wert zeigt der Verweis auf den internen Pfad /av – praktisch für
# Vorführung und lokale Arbeit, aber in Produktion liefe die zweite Marke
# damit unter der falschen Domain.
#
# NICHT ZU VERWECHSELN mit `AV_ORIGIN` in `src/lib/site.ts`. Das ist die
# kanonische Adresse (Canonical, og:url) und steht fest im Code, weil ein
# Deploy zwei Domains bedient und eine Umgebungsvariable nur eine kennt.
# Diese Variable hier ist nur das Ziel eines Links.
# Nötig auf: Production.
NEXT_PUBLIC_AV_URL=https://angebote-vergleichen.info

# ─── Google-Rezensionen (Places API New) ──────────────────────────────
# Wird SERVERSEITIG gelesen (`src/lib/google-reviews.ts`, 6 h zwischen-
# gespeichert).
#
# KEIN NEXT_PUBLIC_-PRÄFIX. Der Schlüssel darf den Server nie verlassen –
# mit Präfix landet er in jedem Browser-Bundle, und Places-Aufrufe kosten.
# Im Google-Cloud-Projekt zusätzlich beschränken: API auf „Places API (New)".
#
# Eine IP-Beschränkung funktioniert auf Vercel NICHT zuverlässig –
# Serverless-Funktionen haben keine feste Ausgangs-IP. Entweder die
# Beschränkung weglassen und stattdessen ein knappes Kontingent setzen, oder
# Vercel Secure Compute mit statischer IP buchen.
GOOGLE_PLACES_API_KEY=

# PFLICHT, BEVOR DER SCHLÜSSEL GESETZT WIRD.
# Ohne ID sucht die Anwendung das Profil selbst – am 07.08. hat diese Suche
# den falschen Betrieb getroffen („Dein Energiepartner GmbH", Bielefeld) und
# dessen Bewertungen ausgespielt.
# Profil: „energiepartner Deutschland", Knowledge-Graph-ID /g/11ntfnqsw5
GOOGLE_PLACE_ID=
